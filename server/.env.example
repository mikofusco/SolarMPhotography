# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4242
# The static frontend's origin(s), so the browser is allowed to call this API.
# e.g. http://localhost:8080 in dev. In production, list both the www and
# non-www versions if your domain answers to both — they count as different
# origins to a browser even though they're "the same site" to a person:
# https://solarmphotography.com,https://www.solarmphotography.com
FRONTEND_ORIGIN=http://localhost:8080

# Stripe — https://dashboard.stripe.com/apikeys (use the test keys while developing)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` (local dev) or your webhook endpoint's settings (production)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified sender/domain in your Resend account. onboarding@resend.dev
# works for testing without verifying your own domain.
RESEND_FROM_EMAIL="SolarM Photography <onboarding@resend.dev>"

# Where new-booking notifications are sent (you, the photographer)
PHOTOGRAPHER_NOTIFICATION_EMAIL=miko@example.com

# Shared secret admin.html sends as the x-admin-key header to view bookings.
# Make this long and random — anyone with this value can read all customer data.
ADMIN_KEY=change-me-to-something-long-and-random
